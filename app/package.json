{
  "name": "norelly-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "pnpm i18n && prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "tauri",
    "e2e": "bash e2e/run.sh",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --silent"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.59.0",
    "@tanstack/virtual-core": "3.19.10",
    "@tauri-apps/api": "2.12.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bits-ui": "2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.29.0",
    "@inlang/plugin-message-format": "4.5.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@wdio/cli": "10.0.2",
    "@wdio/globals": "10.0.2",
    "@wdio/local-runner": "10.0.2",
    "@wdio/mocha-framework": "10.0.1",
    "@wdio/spec-reporter": "10.0.1",
    "@wdio/types": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "10.0.2"
  }
}
