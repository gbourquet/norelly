<?xml version="1.0"?>
<!-- Comme les grands fournisseurs : OAuth2 et mot de passe d'application. -->
<clientConfig version="1.1">
  <emailProvider id="bigmail.example">
    <domain>bigmail.example</domain>
    <domain>bigmail-alias.example</domain>
    <incomingServer type="imap">
      <hostname>imap.bigmail.example</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.bigmail.example</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
    </outgoingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.bigmail.example</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>OAuth2</authentication>
    </outgoingServer>
  </emailProvider>
  <oAuth2>
    <issuer>accounts.bigmail.example</issuer>
    <scope>https://mail.bigmail.example/</scope>
  </oAuth2>
</clientConfig>
