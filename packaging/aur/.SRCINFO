pkgbase = norelly-bin
	pkgdesc = Simple, fast IMAP/SMTP mail client, usable entirely with the mouse
	pkgver = {{version}}
	pkgrel = 1
	url = https://norelly.fr/
	arch = x86_64
	license = MIT OR Apache-2.0
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libsoup3
	depends = webkit2gtk-4.1
	optdepends = gnome-keyring: Secret Service to store account passwords
	optdepends = kwallet: Secret Service to store account passwords (KDE)
	provides = norelly
	conflicts = norelly
	noextract = Norelly_{{version}}_amd64.deb
	options = !strip
	options = !debug
	source = https://github.com/gbourquet/norelly/releases/download/v{{version}}/Norelly_{{version}}_amd64.deb
	source = LICENSE-MIT-{{version}}::https://github.com/gbourquet/norelly/raw/v{{version}}/LICENSE-MIT
	sha256sums = {{sha256_deb}}
	sha256sums = {{sha256_license}}

pkgname = norelly-bin
